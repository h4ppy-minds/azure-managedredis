      "location": "eastus2",
      "networking": {
        "subnet_name": "cfes-amr-eastus2-qa-snet",
        "vnet_name": "az3-cfes-eastus2-npe-vnet",
        "vnet_resource_group_name": "az3-network-cfes-eastus2-npe-rg"
      },
      "dr_networking": {
        "subnet_name": "cfes-amr-centralus-qa-snet",
        "vnet_name": "az3-cfes-centralus-npe-vnet",
        "vnet_resource_group_name": "az3-network-cfes-centralus-npe-rg"
      }
    },
    "uat": {
