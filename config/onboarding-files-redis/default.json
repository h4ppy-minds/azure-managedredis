{
  "type": "redis-onboarding-defaults",
  "default_application_id": "azure-managed-redis",
  "deployment_topology": "HA",
  "node_type": "Balanced_B3",
  "authorization_mode": "AccessKey",
  "eviction_policy": "AllKeysLRU",
  "persistence": {
    "mode": "DISABLED",
    "rdb_frequency": "12h",
    "aof_frequency": "1s"
  },
  "deletion_protection_enabled": true,
  "dr_region_pairs": [
    [
      "eastus2",
      "centralus"
    ]
  ],
  "environments": {
    "dev": {
      "subscription_id": "7cc45e86-c742-421d-b3d3-0c4d5a5ca46d",
      "resource_group_name": "cfes-amr-eastus2-dev-rg",
      "location": "eastus2",
      "networking": {
        "subnet_name": "cfes-amr-eastus2-dev-snet",
        "vnet_name": "az3-cfes-eastus2-npe-vnet",
        "vnet_resource_group_name": "az3-network-cfes-eastus2-npe-rg"
      },
      "dr_networking": {
        "subnet_name": "cfes-amr-centralus-dev-snet",
        "vnet_name": "az3-cfes-centralus-npe-vnet",
        "vnet_resource_group_name": "az3-network-cfes-centralus-npe-rg"
      }
    },
    "qa": {
      "subscription_id": "your-qa-subscription-id",
